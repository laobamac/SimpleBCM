ARCHS = x86_64
ALWAYS_SEARCH_USER_PATHS = NO
VALID_ARCHS = x86_64
SDKROOT = macosx
MACOSX_DEPLOYMENT_TARGET = 15.0
CLANG_CXX_LANGUAGE_STANDARD = c++14
CLANG_CXX_LIBRARY =
CODE_SIGNING_ALLOWED = NO
CODE_SIGN_IDENTITY =
GCC_ENABLE_CPP_EXCEPTIONS = NO
GCC_ENABLE_CPP_RTTI = NO
GCC_ENABLE_FLOATING_POINT_LIBRARY_CALLS = NO
GCC_ENABLE_KERNEL_DEVELOPMENT = YES
GCC_SYMBOLS_PRIVATE_EXTERN = YES
KERNEL_EXTENSION_HEADER_SEARCH_PATHS = $(PROJECT_DIR)/.research/MacKernelSDK/Headers
KERNEL_FRAMEWORK_HEADERS = $(PROJECT_DIR)/.research/MacKernelSDK/Headers
HEADER_SEARCH_PATHS = $(PROJECT_DIR)/.research/Lilu/Lilu $(PROJECT_DIR)/SimpleBCM
LIBRARY_SEARCH_PATHS = $(PROJECT_DIR)/.research/MacKernelSDK/Library/x86_64
OTHER_CFLAGS = -Wall -Wextra -Werror -Wno-unused-parameter -Wno-deprecated-declarations -Wno-ossharedptr-misuse -fno-builtin -fno-asynchronous-unwind-tables -nostdlib
OTHER_LDFLAGS = -static
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) PRODUCT_NAME=SimpleBCM MODULE_VERSION=$(MODULE_VERSION) LILU_CUSTOM_IOKIT_INIT=1
MODULE_NAME = cn.laobamac.SimpleBCM
MODULE_VERSION = 1.0.0
MODULE_START = SimpleBCM_kern_start
MODULE_STOP = SimpleBCM_kern_stop
PRODUCT_NAME = SimpleBCM
PRODUCT_BUNDLE_IDENTIFIER = $(MODULE_NAME)
INFOPLIST_FILE = SimpleBCM/Info.plist
GENERATE_INFOPLIST_FILE = NO
WRAPPER_EXTENSION = kext
COPY_PHASE_STRIP = NO
DEPLOYMENT_POSTPROCESSING = NO
STRIP_INSTALLED_PRODUCT = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES
