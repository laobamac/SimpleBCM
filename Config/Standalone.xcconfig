#include "Kernel.xcconfig"
HEADER_SEARCH_PATHS = $(PROJECT_DIR)/Standalone $(PROJECT_DIR)/SimpleBCM
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) SIMPLEBCM_EMBEDDED=1
